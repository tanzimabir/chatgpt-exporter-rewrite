{
  "name": "chatgpt-exporter",
  "version": "2.0.0",
  "description": "CLI tool to export ChatGPT conversations with branch fidelity and multiple formats",
  "license": "MIT",
  "author": "Tanzim (based on FdezRomero's chatgpt-exporter)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chatgpt-exporter": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tanzim/chatgpt-exporter-rewrite.git"
  },
  "keywords": [
    "chatgpt",
    "backup",
    "export",
    "cli",
    "markdown",
    "conversation"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "js-yaml": "^4.1.0",
    "ora": "^9.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.0",
    "tsup": "^8.1.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  }
}
